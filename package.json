{
  "name": "agentforge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": { "node": ">=22" },
  "scripts": {
    "gen:templates": "node tools/gen-templates.mjs",
    "check:poc-static": "node tools/extract-poc-static.mjs --check",
    "build": "pnpm gen:templates && pnpm -r --filter ./packages/** build",
    "typecheck": "pnpm gen:templates && pnpm -r --filter ./packages/** typecheck",
    "lint": "eslint .",
    "test": "pnpm build && pnpm -r --filter ./packages/** test",
    "test:scripts": "bash tests/scripts/run.sh",
    "dev": "pnpm --filter @agentforge/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
